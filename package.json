{
  "name": "ev-charge-circle",
  "version": "1.0.0",
  "description": "Community app for office EV drivers sharing one charger",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:demo": "node scripts/seed-demo.js",
    "lint": "eslint .",
